+      - name: Resolve QR selection
+        shell: bash
+        env:
+          DISPATCH_QR_TYPE: ${{ github.event_name == 'workflow_dispatch' && inputs.qr_type || '' }}
+        run: |
+          set -euo pipefail
+          qr_type="${DISPATCH_QR_TYPE:-both}"
+          if [[ "${GITHUB_EVENT_NAME}" != "workflow_dispatch" ]]; then
+            qr_type="both"
+          fi
+          case "$qr_type" in
+            both|work-profile|fully-managed) ;;
+            *) echo "Unsupported qr_type: $qr_type" >&2; exit 2 ;;
+          esac
+          echo "DPC_AIO_QR_TYPE=$qr_type" >> "$GITHUB_ENV"
+          echo "QR selection: $qr_type"
+
+      - name: Mask manual release password
+        if: ${{ github.event_name == 'workflow_dispatch' }}
+        shell: bash
+        env:
+          RELEASE_SIGNING_PASSWORD: ${{ inputs.release_signing_password }}
+        run: |
+          set -euo pipefail
+          if (( ${#RELEASE_SIGNING_PASSWORD} < 12 )); then
+            echo "release_signing_password must contain at least 12 characters" >&2
+            exit 2
+          fi
+          printf '::add-mask::%s\n' "$RELEASE_SIGNING_PASSWORD"
+          printf 'DPC_AIO_MANUAL_SIGNING_PASSWORD=%s\n' "$RELEASE_SIGNING_PASSWORD" >> "$GITHUB_ENV"
