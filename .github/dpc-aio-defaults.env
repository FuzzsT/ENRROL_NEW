# DPC-AIO repository-local fallback configuration.
# GitHub Secrets/Variables override these values.
# Keep real secrets OUT of this file. Empty values intentionally select safe standalone behavior.
DPC_AIO_DEFAULT_RELEASE_APK_NAME=DPC-AIO-enterprise-release.apk
DPC_AIO_DEFAULT_CONTINUOUS_RELEASE_TAG=dpc-aio-continuous
DPC_AIO_DEFAULT_EMERGENCY_RELEASE_TAG=dpc-aio-emergency-enrollment
DPC_AIO_DEFAULT_POLICY_PROFILE=default
DPC_AIO_DEFAULT_PROVISIONING_MODE=work-profile
DPC_AIO_DEFAULT_ALLOW_OFFLINE=false
DPC_AIO_DEFAULT_ENROLLMENT_OFFLINE_MODE=ONLINE
DPC_AIO_DEFAULT_OFFLINE_BUNDLE_ID=
DPC_AIO_DEFAULT_ENROLLMENT_ENDPOINT=
DPC_AIO_DEFAULT_ENROLLMENT_SIGNING_PUBLIC_KEY=
DPC_AIO_DEFAULT_ENROLLMENT_TOKEN=
# Signing material is intentionally not stored here. Manual zero-settings runs
# persist an AES/PBKDF2-encrypted keystore in the rolling GitHub Release asset.
